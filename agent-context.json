{
  "schema_version": "1.0",
  "repository": "gabrielmahia/africa-coord-bus",
  "project": "africa-coord-bus",
  "stable_branch": "main",
  "integration_branch": "main",
  "purpose": "Coordination event bus connecting East Africa MCP servers — drought alerts cascade to insurance, health, and agricultural advisory in real time.",
  "cold_start": [
    "AGENTS.md",
    "README.md"
  ],
  "commands": {
    "test": "see .github/workflows/ci.yml",
    "lint": "see .github/workflows/ci.yml"
  },
  "coordination": {
    "task_registry": "GitHub Issues",
    "work_claim": "Draft PR",
    "branch_pattern": "agent/<agent-name>/<issue-number>-<slug>",
    "pr_title_pattern": "[CLAIM #<issue>] <agent-name>: <scope>",
    "authority": "Tests and external reality, not model consensus"
  },
  "current_workstreams": [],
  "prohibited_autonomous_actions": [
    "change licensing",
    "expose credentials",
    "present simulated or demo data as real",
    "weaken a safety guard or truth label"
  ],
  "reasoning_standard": {
    "id": "coverage-adaptive-reasoning:v2",
    "canonical": "https://github.com/gabrielmahia/nairobi-stack/blob/main/docs/COVERAGE_ADAPTIVE_REASONING.md"
  }
}
